{
  "name": "dreamlog",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "scripts": {
    "dev": "vite",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-dreamlog",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dreamlog \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-dreamlog \"playwright test\"",
    "test:e2e:quick": "firebase emulators:exec --only auth,firestore --project demo-dreamlog \"playwright test --project=desktop\"",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:rules && npm run test:e2e && npm run build && npm audit --audit-level=low",
    "icons": "node scripts/make-icons.mjs"
  }
}
