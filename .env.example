# Firebase web config. These values are public by design (not secrets); copy to .env.local.
# Leave empty to run against the emulators with the demo-dreamlog project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to true with `npm run emulators` running.
VITE_USE_EMULATORS=true
